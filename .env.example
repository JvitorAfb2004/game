# === Backend (EasyPanel → Service → Environment) ===
# Obrigatórias em produção (o server recusa subir sem elas):
DATABASE_URL=postgres://postgres:SENHA@postgres:5432/game?sslmode=disable
JWT_SECRET=troque-por-32-caracteres-aleatorios
# Opcionais:
# Frontend(s) permitidos no CORS, separados por vírgula:
# FRONTEND_URL=https://seu-jogo.com
# Redis (cache futuro; hoje o jogo roda sem):
# REDIS_URL=redis://default:SENHA@redis:6379
# Porta interna (EasyPanel injeta PORT sozinho; só defina se precisar):
# PORT=3001
# Chat dos bots via NVIDIA NIM (sem ela, usa falas locais):
# NIM_API_KEY=
# NIM_MODEL=meta/llama-3.1-8b-instruct

# === Frontend (build do site estático no EasyPanel) ===
# Origem pública do backend:
# VITE_API_URL=https://api.seu-dominio.com
# WebSocket público do backend:
# VITE_WS_URL=wss://api.seu-dominio.com/ws

# === Local (dev) ===
# Sem VITE_* o front usa http(s)://<host>:3001 sozinho.
# Sem DATABASE_URL/JWT_SECRET o back usa localhost + segredo de dev.
