{
  "name": "blackwater",
  "version": "1.0.0",
  "private": true,
  "description": "An open-source Three.js tactical first-person shooter set in a rain-soaked freight terminal.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types verify-world.mjs && node --experimental-strip-types verify-movement.mjs && node --experimental-strip-types verify-graphics.mjs",
    "test:browser": "node verify-browser.mjs",
    "server": "tsx watch server/index.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "server:test": "tsx --test server/*.test.ts",
    "format": "oxfmt",
    "lint": "oxlint"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.0",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "1.31.0",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "0.180.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "^1.63.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
  }
}
